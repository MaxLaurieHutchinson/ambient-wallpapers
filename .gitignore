# Track only the reusable skill, showcase and distributable artifacts.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/skills/
!/showcase/
!/tools/
!/dist/

/tools/*
!/tools/package_ambient_skill.py

/dist/*

# Root documentation outside the allowlist.
!/LICENSE
!/LICENSE.md
!/CONTRIBUTING.md
!/SECURITY.md
!/docs/
